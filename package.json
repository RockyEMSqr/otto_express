{
  "name": "@emsquared/otto_express",
  "version": "1.0.1",
  "description": "",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "source": "index.ts",
  "scripts": {
    "test": "DEBUG=1 node --inspect -r esbuild-register test/server.ts",
    "test:brk": "DEBUG=1 tsx --inspect-brk test/server.ts",
    "test:swc": "node --inspect -r @swc/register test/server.ts",
    "build": "tsc -p tsconfig.cjs.json ; tsc -p tsconfig.esm.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockyEMSqr/otto_express.git"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RockyEMSqr/otto_express/issues"
  },
  "homepage": "https://github.com/RockyEMSqr/otto_express#readme",
  "dependencies": {
    "@types/express": "^4.17.13",
    "dlv": "^1.1.3",
    "express": "^5.0.1",
    "express-session": "^1.17.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "esbuild": "^0.14.10",
    "esbuild-register": "^3.3.1",
    "htm": "^3.1.0",
    "preact-render-to-string": "^5.1.19",
    "typescript": "^5.7.2",
    "tsx": "^4.20.6"
  },
  "optionalDependencies": {
    "connect-sqlite3": "^0.9.16"
  }
}